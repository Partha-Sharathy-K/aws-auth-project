pipeline {
    agent any

    environment {
        APP_NAME = "aws-backend"
        CONTAINER_NAME = "aws-backend-container"
        PORT = "8080"
    }

    stages {

        stage('Build Docker Image') {
            steps {
                dir('backend/aws-springboot-project') {
                    sh '''
                      echo "📦 Current directory:"
                      pwd
                      echo "📁 Files:"
                      ls -la
                      echo "🐳 Building Docker image"
                      docker build -t $APP_NAME .
                    '''
                }
            }
        }

        stage('Stop Old Container') {
            steps {
                sh 'docker rm -f $CONTAINER_NAME || true'
            }
        }

        stage('Run Container') {
            steps {
                sh '''
                  docker run -d \
                    --name $CONTAINER_NAME \
                    --network aws-network \
                    -p $PORT:$PORT \
                    $APP_NAME
                '''
            }
        }
    }

    post {
        success {
            echo "✅ Backend deployed successfully!"
        }
        failure {
            echo "❌ Deployment failed"
        }
    }
}

